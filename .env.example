# Copie para .env na raiz do app React (Vite) e preencha.
# Valores em: Console do Firebase > Configurações do projeto > Seus apps > App da Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Client ID do OAuth (o mesmo do functions/.env)
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# true para usar os emuladores locais
VITE_USE_EMULATORS=false
